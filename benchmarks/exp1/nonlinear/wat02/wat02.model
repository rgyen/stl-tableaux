# logging: ode
# model description:
#
# Two water tanks are connected by a single pipe.
# The water level of each tank is separately controlled
# by each pump and is affected by the adjacent water level.
# time bound : 1

int modeId;
[0, 10] x;
{ mode: modeId = 1;
  inv:  x > 1;
  flow: d/dt[x] = (-0.01 * 4.43 * sqrt(x));
  jump: (x < 5) =>
          (and (modeId' = 2) (x' = x));

}
{ mode: modeId = 2;
  inv:  x < 8;
  flow: d/dt[x] = 0.8 - 0.01 * 4.43 * sqrt(x); 
  jump: (x >= 2)  =>
          (and (modeId' = 1) (x' = x));
}
init: modeId = 1; 4 <= x; x <= 4.5;

proposition:

goal:
[f1]: [][0.0, inf) x >= 0; 
[f2]: (<>[0, 4] x >= 5) R[0,inf) x >= 2;
[f3]: ([][0.0, inf) x <= 6) U[1.2, 3.0] (x > 5);




