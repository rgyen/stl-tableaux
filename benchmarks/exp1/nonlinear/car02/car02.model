# logging: ode
int modeId;
[-40, 40] rx;
[-40, 40] ry;
[0, 1.5] theta1;

#  car1 : inc, inc 
{
    mode:
        modeId = 1;
    inv:
	rx < 20;
	ry < 20;
	theta1 < 1.4;
    flow:
        d/dt[rx] = 1;
        d/dt[ry] = 2 * sin(theta1);
	d/dt[theta1] = 0.05;
    jump:
	(and (rx < 2) (ry < 2)) =>
