int modeId;
[0, 10] duration; [-10, 10] u;
[-10, 10] v;
{ mode: modeId = 1;
  inv:  duration < 5;
  flow: d/dt[duration] = 1;
        d/dt[u] = - 0.9 * u * u - u * u * u - 0.9 * u - v + 1;
        d/dt[v] = u - 2 * v;
  jump:
    (duration >= 5) => (and (modeId' = 2)
                            (u' = u) (v' = v)
                            (duration' = 0));
}
{ mode: modeId = 2;
  inv:  duration < 20;
  flow: d/dt[duration] = 1;
        d/dt[u] = - 0.9 * u * u - u * u * u - 0.9 * u - v;
        d/dt[v] = u - 2 * v;
  jump:
    (duration >= 20) => (and (modeId' = 1)
                             (u' = u) (v' = v)
                             (duration' = 0));
}

init:
    modeId = 1;
    0 <= duration; duration <= 0.01;
    0 <= u; u <= 0.01; 0 <= v; v <= 0.01;

proposition:

# time-bound : 90, bound : 10, threshold : 0.1
goal:
[f1] : ([][5, 50] u >= 0.5) U[0, inf) v >= 0.9;
[f2]: [][1, 5] (u > 4 -> <> [6, 10] (u < 2));
[f3]: (u <= 10) U[5, 15] (duration >= 10);
