int modeId;
[-100, 100] x;
[-100, 100] y;
[-30, 30] vx;
[-30, 30] vy;

# n = 0.5, m_c = 10, 
{
    mode:
        modeId = 1;
    inv:
	(x >= 40); 
	(y >= 40);
    flow:
        d/dt[x] = vx;
        d/dt[y] = vy;
        d/dt[vx] = 0.07 * x + 0.1 * vy - 4;
        d/dt[vy] = - 0.1 * vx - 2; 
    jump:
        (or (x <= 50) (y <= 50)) =>
           (and (modeId' = 2) 
                (x' = x) (y' = y) (vx' = vx) (vy' = vy));
}
{
    mode:
        modeId = 2;
    inv:
	vx >= -5;
	vy >= -5;
	x <= 50;
	y <= 50;
    flow:
        d/dt[x] = vx;
        d/dt[y] = vy;
        d/dt[vx] = 0.07 * x + 0.1 * vy - 3;
        d/dt[vy] = - 0.1 * vx - 1;
    jump:
	(or (vx <= -4) (vy <= -4)) => 
           (and (modeId' = 3) 
                (x' = x) (y' = y) (vx' = vx) (vy' = vy));
}
{
    mode:
	modeId = 3;
    inv:
        x <= 50;
        y <= 50;
    flow:
        d/dt[x] = vx;
        d/dt[y] = vy;
        d/dt[vx] = 0.07 * x + 0.1 * vy + 4; 
        d/dt[vy] = - 0.1 * vx + 6;
    jump:
        (and (x > 45) (y > 45))  =>
           (and (modeId' = 1)
                (x' = x) (y' = y) (vx' = vx) (vy' = vy));
        (or (vx >= 3) (vy >= 3)) =>
           (and (modeId' = 2)
                (x' = x) (y' = y) (vx' = vx) (vy' = vy)); 
}

init:
modeId = 1; 
x <= 70; x >= 60; 
y <= 70; y >= 60; 
vx <= 0; vx >= -1; 
vy <= 0; vy >= -1;

proposition:


goal:
[f1]: [][2, 3] (<>[0, 2] (x <= 30)); 
[f2]: <>[0, 4] (x >= 30 U[0.0, inf) vx <= -2); 
[f3]: [][0.0, inf) (x > 56 -> <>[1.1, 6] x >= 50); 
