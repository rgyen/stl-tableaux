int modeId;
[-20, 20] vx;
[-20, 20] sx;
[-20, 20] ax;
[-20, 20] w;
[-20, 20] vy;
[-20, 20] sy;

# 1 -> 2 -> 3 -> 4 -> 5 -> 6 -> 7
# Slow down
{
    mode:
        modeId = 1;
    inv:
	sx + 10 < 0; 
    flow:
        d/dt[vx] = 0.1 * ax;
        d/dt[sx] = vx - 2.5;
	d/dt[ax] = - 0.01 * sx - 0.103 + 0.84 - 0.3 * vx - 0.5 * ax;
	d/dt[w] = -2 * w;
	d/dt[vy] = -2 * vy;
	d/dt[sy] = 0.1 *vy;
    jump:
        ((sx + 10) >= 0) =>
            (and (modeId' = 2) (vx' = vx) (sx' = sx) (ax' = ax) (w' = w) (vy' = vy) (sy' = sy));
}
# Start turn 1
{
    mode:
        modeId = 2;
    inv:
	sy < 12;
    flow:
        d/dt[vx] = 0.1 * ax;
        d/dt[sx] = vx - 2.5;
        d/dt[ax] = -0.5 * vx + 1.4 - 0.5 * ax;
        d/dt[w] = 3 - 0.15 * w + 0.2 - 0.01 * sy;
        d/dt[vy] = 7.5 - 0.45 * w + 0.5 - 0.0025 * sy - 0.05 * vy;
        d/dt[sy] = 0.1 *vy;
    jump:
        (sy >= 12) =>
            (and (modeId' = 3) (vx' = vx) (sx' = sx) (ax' = ax) (w' = w) (vy' = vy) (sy' = sy));
}
# End turn 1
{
    mode:
        modeId = 3;
    inv:
	vy > 0.05;
    flow:
        d/dt[vx] = 0.1 * ax;
        d/dt[sx] = vx - 2.5;
        d/dt[ax] = -0.5 * vx + 1.4 - 0.5 * ax;
        d/dt[w] = -0.1*w + 0.2 - 0.01 * sy;
        d/dt[vy] = -0.25 * w + 0.5 - 0.025 * sy - 0.05 * vy;
        d/dt[sy] = 0.1 *vy;
    jump:
        (vy <= 0.05) =>
            (and (modeId' = 4) (vx' = vx) (sx' = sx) (ax' = ax) (w' = w) (vy' = vy) (sy' = sy));
}
# Speed up
{
    mode:
        modeId = 4;
    inv:
        sx < 10 ;
    flow:
        d/dt[vx] = 0.1 * ax;
        d/dt[sx] = vx - 2.5;
        d/dt[ax] = - 0.01 * sx + 0.74 - 0.3 * vx - 0.5 * ax;
        d/dt[w] = -2 * w;
        d/dt[vy] = -2 * vy;
        d/dt[sy] = 0.1 *vy;
    jump:
        (sx >= 10) =>
            (and (modeId' = 5) (vx' = vx) (sx' = sx) (ax' = ax) (w' = w) (vy' = vy) (sy' = sy));
}
# Start turn 2 
{
    mode:
        modeId = 5;
    inv:
        sy > 3.5;
    flow:
        d/dt[vx] = 0.1 * ax;
        d/dt[sx] = vx - 2.5;
        d/dt[ax] = -0.5 * vx + 1.4 - 0.5 * ax;
        d/dt[w] = -3 - 0.15 * w + 0.2 - 0.01 * sy;
        d/dt[vy] = -7.5 - 0.45 * w + 0.5 - 0.025 * sy - 0.05 * vy;
        d/dt[sy] = 0.1 *vy;
    jump:
        (sy <= 3.5) =>
            (and (modeId' = 6) (vx' = vx) (sx' = sx) (ax' = ax) (w' = w) (vy' = vy) (sy' = sy));
}
# End turn 2
{
    mode:
        modeId = 6;
    inv:
	vy + 0.05 < 0;
    flow:
        d/dt[vx] = 0.1 * ax;
        d/dt[sx] = vx - 2.5;
        d/dt[ax] = -0.5 * vx + 1.4 - 0.5 * ax;
        d/dt[w] = -0.1*w + 0.2 - 0.01 * sy;
        d/dt[vy] = -0.25 * w + 0.5 - 0.025 * sy - 0.05 * vy;
        d/dt[sy] = 0.1 *vy;
    jump:
        ((vy + 0.05) >= 0) =>
            (and (modeId' = 7) (vx' = vx) (sx' = sx) (ax' = ax) (w' = w) (vy' = vy) (sy' = sy));
}
# Continue
{
    mode:
        modeId = 7;
    inv:
    flow:
        d/dt[vx] = 0.1 * ax;
        d/dt[sx] = vx - 2.5;
        d/dt[ax] = -0.5 * vx + 1.4 - 0.5 * ax;
        d/dt[w] = -2 * w;
        d/dt[vy] = -2 * vy;
        d/dt[sy] = 0.1 *vy;
    jump:
}
init:
(modeId = 1); 
(-15 <= sx); (sx <= -14.95); 
(3.25 <= vx); (vx <= 3.3); 
(0 <= ax); (ax <= 0.1); 
(0 <= w); (w <= 0.1); 
(0 <= vy); (vy <= 0.1); 
(0 <= sy); (sy <= 0.1);

proposition:

# bound: 5, timebound : 100
goal:
[f1]: <>[20, 50] ([] [5, 8] sx < 30); # threshold: 0.1
[f2]: (<>[0, inf) (sx >= -13)) U[0,inf) (sy >= 4); # threshold: 0.1
[f3]: ([][0, 32] ((w >= 2.5) R[0, inf) (vx >= 9))); # threshold: 0.1
