     < C, Λ . (L, [[] f] , X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f], X (*), X (C', Λ' . L')) :: INV :: (GOALS, [[] f]) :: M > 
  if not isContradiction((C, C')) .

