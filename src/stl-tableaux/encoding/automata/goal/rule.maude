     < C, Λ . (L, (c)-(d)<> I f, X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f], X (C', Λ' . L'), 
                X (c >= inf(I), d >= inf(I))) :: (INV, c <= sup(I)) :: (GOALS, (c)-(d)<> I f) :: M > 
  if not isContradiction((C, C')) .
endm

--- previous version

mod DECOMP-PREV-RULES is
  pr DECOMP-RULES-AUX .

  vars N N' N'' M M' : Nat .
  vars f f1 f2 : Formula .
  var I : Interval .
  vars c d : Clock .
  vars B B' BL BL' : Bool .
  vars Ψ C L C' L' INV GOALS : Set{Judgement} .
  var Φ : NeSet{Judgement} .
  vars Λ Λ' : Set{ClkReset} .
  var NM : Number .
  vars CS CS1 CS2 : Set{Clock} .
  var CMAP : CMap .

-----------------------
------- common --------
-----------------------

  crl [and-prev] : 
     < C, Λ . (L, [f1 /\ f2], X (C', Λ' . L)) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f1], [f2], X (C', Λ' . L)) :: INV :: GOALS :: M > 
  if not isContradiction((C, C')) .
  
  crl [or-le-prev] : 
     < C, Λ . (L, [f1 \/ f2], X (C', Λ' . L)) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f1], X (C', Λ' . L)) :: INV :: GOALS :: M > 
  if not isContradiction((C, C')) .
  
  crl [or-ri-prev] : 
     < C, Λ . (L, [f1 \/ f2], X (C', Λ' . L)) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f2], X (C', Λ' . L)) :: INV :: GOALS :: M > 
  if not isContradiction((C, C')) .
  
  crl [until-1-prev] : 
     < C, Λ . (L, [f1 U f2] , X (C', Λ' . L)) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f1], [f2], X (C', Λ' . L)) :: INV :: GOALS :: M > 
  if not isContradiction((C, C')) .

  crl [until-2-prev] : 
     < C, Λ . (L, [f1 U f2] , X (C', Λ' . L)) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f1], X ([f1 U f2]), X (C', Λ' . L)) :: INV :: GOALS :: M > 
  if not isContradiction((C, C')) .
  
  crl [release-1-prev] : 
     < C, Λ . (L, [f1 R f2] , X (C', Λ' . L)) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f1], X (C', Λ' . L)) :: INV :: GOALS :: M > 
  if not isContradiction((C, C')) .
  
  crl [release-2-prev] : 
     < C, Λ . (L, [f1 R f2] , X (C', Λ' . L)) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f2], X ([f1 R f2]), X (C', Λ' . L)) :: INV :: GOALS :: M > 
  if not isContradiction((C, C')) .
  
  crl [release-3-prev] : 
     < C, Λ . (L, [f1 R f2] , X (C', Λ' . L)) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f2], X (*), X (C', Λ' . L)) :: INV :: GOALS :: M > 
  if not isContradiction((C, C')) .

-----------------------
------- always --------
-----------------------

  crl [always-ipstl-prev] : 
     < C, Λ . (L, [[] I f], X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, ((c := Num("0.0")) . ((c)==()[] I f)), X (C', Λ' . L')) :: INV :: (GOALS, [[] I f]) :: M' > 
  if {c, M'} := clkFreshGen(M) /\ not isContradiction((C, C')) .

  crl [always-up-1-prev] : 
     < C, Λ . (L, (c)==()[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, X (c <= inf(I), *), X (C', Λ' . L')) :: INV :: (GOALS, (c)==()[] I f) :: M > 
  if not isContradiction((C, C')) .

  crl [always-up-2-prev] : 
     < C, Λ . (L, (c)==()[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, X (c <= inf(I), (d := Num("0.0")) . ((c)==(d)[] I f)), X (C', Λ' . L')) :: INV :: (GOALS, (c)==()[] I f) :: M' >
  if {d, M'} := clkFreshGen(M) /\ not isContradiction((C, C')) .

  crl [always-up-3-prev] : 
     < C, Λ . (L, (c)==()[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M >
  => < C, Λ . (L, [f], (()**()[] I f), X (c >= inf(I)), X (C', Λ' . L')) :: (INV, c <= inf(I)) :: (GOALS, (c)==()[] I f) :: M > 
  if not isContradiction((C, C')) .

  crl [always-updown-1-prev] : 
     < C, Λ . (L, (c)==(d)[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, X (c <= inf(I), (c)==(d)[] I f), X (C', Λ' . L')) :: INV :: (GOALS, (c)==(d)[] I f) :: M >
  if not isContradiction((C, C')) . 

  crl [always-updown-2-prev] : 
     < C, Λ . (L, (c)==(d)[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, X (c <= inf(I), *), X (C', Λ' . L')) :: INV :: (GOALS, (c)==(d)[] I f) :: M >
  if not isContradiction((C, C')) .

  crl [always-updown-3-prev] : 
     < C, Λ . (L, (c)==(d)[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f], (()**(d)[] I f), X (c >= inf(I)), X (C', Λ' . L')) 
              :: (INV, c <= inf(I)) :: (GOALS, (c)==(d)[] I f) :: M > 
  if not isContradiction((C, C')) .

  crl [always-up-intersect-1-prev] : 
     < C, Λ . (L, ()**()[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M >
  => < C, Λ . (L, X ((d := Num("0.0")) . ([f], ()**(d)[] I f)), X (C', Λ' . L')) 
            :: INV :: (GOALS, ()**()[] I f) :: M' >
  if {d, M'} := clkFreshGen(M) /\ not isContradiction((C, C')) .

  crl [always-up-intersect-2-prev] : 
     < C, Λ . (L, ()**()[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M >
  => < C, Λ . (L, X (*), X (C', Λ' . L')) :: INV :: (GOALS, ()**()[] I f) :: M >
  if not isContradiction((C, C')) .
  
  crl [always-updown-intersect-1-prev] : 
     < C, Λ . (L, ()**(d)[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M >
  => < C, Λ . (L, X ([f], ()**(d)[] I f, d <= sup(I)), X (C', Λ' . L')) 
            :: INV :: (GOALS, ()**(d)[] I f) :: M >
  if not isContradiction((C, C')) .

  crl [always-updown-intersect-2-prev] : 
     < C, Λ . (L, ()**(d)[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M >
  => < C, Λ . (L, X (d >= sup(I)), X (C', Λ' . L')) :: INV :: (GOALS, ()**(d)[] I f) :: M >
  if not isContradiction((C, C')) .

  crl [always-updown-intersect-3-prev] : 
     < C, Λ . (L, ()**(d)[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M >
  => < C, Λ . (L, X (*), X (C', Λ' . L')) :: INV :: (GOALS, ()**(d)[] I f) :: M >
  if not isContradiction((C, C')) .

-----------------------
----- eventually ------
-----------------------

endm

smod DECOMP-RULE-APP is
  pr DECOMP-RULES-COMPLEX .
  pr DECOMP-RULES-SIMPLE .
  pr DECOMP-PREV-RULES .

