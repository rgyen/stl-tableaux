     < C, Λ . (L, [[] I f], X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, ((c := Num("0.0")) . ((c)-()[] I f)), X (C', Λ' . L')) :: INV :: (GOALS, [[] I f]) :: M' > 
