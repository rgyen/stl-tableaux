     < C, Λ . (L, (c)-(d)[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, X (c <= inf(I), (c)-(d)[] I f), X (C', Λ' . L')) :: INV :: (GOALS, (c)-(d)[] I f) :: M >
  if not isContradiction((C, C')) . 

  crl [always-updown-2-simp] : 
     < C, Λ . (L, (c)-(d)[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, X (c <= inf(I), *), X (C', Λ' . L')) :: INV :: (GOALS, (c)-(d)[] I f) :: M >
  if not isContradiction((C, C')) .

  crl [always-updown-3-simp] : 
     < C, Λ . (L, (c)-(d)[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f], X (c >= inf(I), *), X (C', Λ' . L')) 
              :: (INV, c <= inf(I)) :: (GOALS, (c)-(d)[] I f) :: M > 
  if not isContradiction((C, C')) .

  crl [always-updown-4-simp] : 
     < C, Λ . (L, (c)-(d)[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M >
  => < C, Λ . (L, [f], 
            X (c >= inf(I), d <= sup(I), 
                (c := inf(I)) . ((c)-(d)[] I f)), X (C', Λ' . L')) 
            :: (INV, c <= inf(I)) :: (GOALS, (c)-(d)[] I f) :: M > 
  if not isContradiction((C, C')) .

  crl [always-updown-5-simp] : 
     < C, Λ . (L, (c)-(d)[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M >
  => < C, Λ . (L, [f], 
            X (c >= inf(I), d >= sup(I)), X (C', Λ' . L')) 
            :: (INV, c <= inf(I)) :: (GOALS, (c)-(d)[] I f) :: M > 
  if not isContradiction((C, C')) /\ not (sup(I) == infty) .

