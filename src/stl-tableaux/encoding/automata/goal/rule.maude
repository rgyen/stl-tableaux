     < C, Λ . (L, (c)-()[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M >
  => < C, Λ . (L, [f], 
            X (c >= inf(I), (c := inf(I), d := Num("0.0")) . ((c)-(d)[] I f)), X (C', Λ' . L')) 
            :: (INV, c <= inf(I)) :: (GOALS, (c)-()[] I f) :: M' >
  if {d, M'} := clkFreshGen(M) /\ not isContradiction((C, C')) .

  crl [always-up-4-simp-hidden-loop] : 
     < C, Λ . (L, (c)-()[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M >
  => < C, Λ . (L, [f], 
            X (c >= inf(I), (c := inf(I)) . ((c)-()[] I f)), X (C', Λ' . L')) 
