fmod NUMBER is
  sort Number .
endfm

fmod INTERVAL is
  pr NUMBER .

  sort Interval .

  vars LN RN : Number .
  vars LB RB : Bool .

  op |_,_,_,_| : Bool Number Number Bool -> Interval [ctor] .
  ops inf sup : Interval -> Number .
  eq inf(| LB, LN, RN, RB |) = LN .
  eq sup(| LB, LN, RN, RB |) = RN .
endfm

fmod PROP is
  sort Prop .
endfm

--- STL formula
fmod FORMULA is
  pr INTERVAL .
  inc PROP .

  sort Formula .
  subsort Prop < Formula .

  op _/\_ : Formula Formula -> Formula [comm ctor gather(E e) prec 55] .
  op _\/_ : Formula Formula -> Formula [comm ctor gather(E e) prec 59] .
  op _U_ : Formula Formula -> Formula [ctor prec 63] .
  op _R_ : Formula Formula -> Formula [ctor prec 63] .
  op []__ : Interval Formula -> Formula [prec 53] .
  op <>__ : Interval Formula -> Formula [prec 53] .

  op []_ : Formula -> Formula [prec 53] .
  op <>_ : Formula -> Formula [prec 53] .
endfm

fmod CLOCK is
  sort Clock .
endfm

view Clock from TRIV to CLOCK is
  sort Elt to Clock .
endv

fmod CLK-RESETS is 
  pr CLOCK .
  pr NUMBER .

  sort ClkReset .
  op _:=_ : Clock Number -> ClkReset [ctor] .
endfm

view ClkReset from TRIV to CLK-RESETS is
  sort Elt to ClkReset .
endv

fmod INTERVAL-PREDICATE is
  pr CLOCK .
  pr FORMULA .

  sorts CIntvPred IntvPred .
  subsort CIntvPred < IntvPred .

  op [_]                : Formula -> IntvPred [ctor] .
  op (_,_)-(_,_)[]__    : Bool Clock Clock Bool Interval Formula -> CIntvPred [ctor] .
  op (_,_)-(_,_)<>__    : Bool Clock Clock Bool Interval Formula -> CIntvPred [ctor] .
  op (_,_)-()[]__       : Bool Clock Interval Formula -> CIntvPred [ctor] .
  op (_,_)-()<>__       : Bool Clock Interval Formula -> CIntvPred [ctor] .

--- Simple version

  op (_)-(_)[]__        : Clock Clock Interval Formula -> CIntvPred [ctor] .
  op (_)-(_)<>__        : Clock Clock Interval Formula -> CIntvPred [ctor] .
  op (_)-()[]__         : Clock Interval Formula -> CIntvPred [ctor] .
  op (_)-()<>__         : Clock Interval Formula -> CIntvPred [ctor] .

--- Prev version

  op (_)==(_)[]__        : Clock Clock Interval Formula -> CIntvPred [ctor] .
  op (_)==(_)<>__        : Clock Clock Interval Formula -> CIntvPred [ctor] .
  op (_)==()[]__         : Clock Interval Formula -> CIntvPred [ctor] .
  op (_)==()<>__         : Clock Interval Formula -> CIntvPred [ctor] .

  op ()**()[]__        : Interval Formula -> CIntvPred [ctor] .
  op ()**()<>__        : Interval Formula -> CIntvPred [ctor] .
  op ()**(_)[]__       : Clock Interval Formula -> CIntvPred [ctor] .
  op ()**(_)<>__       : Clock Interval Formula -> CIntvPred [ctor] .
endfm

fmod JUDGEMENT is 
  sort Judgement .
endfm

view Judgement from TRIV to JUDGEMENT is
  sort Elt to Judgement .
endv

fmod JUDGEMENTS is
  pr FORMULA .
  pr SET{Clock} .
  pr SET{ClkReset} .
  pr SET{Judgement} .
  inc INTERVAL-PREDICATE .

  sorts NonClockJudgement ClockJudgement .
  subsort ClockJudgement < Judgement .
  subsorts IntvPred < NonClockJudgement < Judgement .

----------------------------
------ Judgement Def. ------
----------------------------

  op * : -> Judgement [ctor] .
  op lc? : Bool -> Judgement [ctor] .
  op _<=[_]_ : Clock Bool Number -> Judgement [ctor] .
  op _>=[_]_ : Clock Bool Number -> Judgement [ctor] .
  op _<=_ : Clock Number -> Judgement [ctor] . --- simple
  op _>=_ : Clock Number -> Judgement [ctor] . --- simple version
  op X_ : Set{Judgement} -> Judgement [ctor prec 65 frozen (1)] .
  op _._ : Set{ClkReset} Set{Judgement} -> Judgement [ctor prec 65 frozen(2)] .

  vars Ψ Ψ' JS JS' : Set{Judgement} .
  vars Φ Φ' : NeSet{Judgement} .
  vars Λ Λ' : Set{ClkReset} .
  var f : Formula .
  vars c d : Clock .
  vars B B' : Bool .
  var NB : Number .
  var I : Interval .
  vars VS VS' : Set{Clock} .

----------------------------
-------- Membership --------
----------------------------

  mb c <=[B] NB : ClockJudgement .
  mb c >=[B] NB : ClockJudgement .
  mb * : ClockJudgement .
  mb lc?(B) : NonClockJudgement .

----------------------------
------ Free variables ------
----------------------------

  op fv : Set{Judgement} -> Set{Clock} .
  eq fv(*) = empty .
  eq fv([f]) = empty .
  eq fv((Φ, Φ')) = union(fv(Φ), fv(Φ')) .
  eq fv(X Ψ) = fv(Ψ) .
  eq fv(Λ . Ψ) = fv(Ψ) \ clkVars(Λ) .
  eq fv(lc?(B)) = empty .
  eq fv(empty) = empty .

--- Ignore open close

  eq fv((c)-()[] I f) = c .
  eq fv((c)-()<> I f) = c .
  eq fv((c)-(d)[] I f) = c, d .
  eq fv((c)-(d)<> I f) = c, d .
  eq fv(c <= NB) = c .
  eq fv(c >= NB) = c .

--- Open close 

  eq fv((B,c)-()[] I f) = c .
  eq fv((B,c)-()<> I f) = c .
  eq fv((B,c)-(d,B')[] I f) = c, d .
  eq fv((B,c)-(d,B')<> I f) = c, d .
  eq fv(c <=[B] NB) = c .
  eq fv(c >=[B] NB) = c .

--- Previous version
--- Debugging purpose

  eq fv((c)==(d)[] I f) = c, d .
  eq fv((c)==(d)<> I f) = c, d .
  eq fv((c)==()[] I f) = c .
  eq fv((c)==()<> I f) = c .
  eq fv(()**()[] I f) = empty .
  eq fv(()**()<> I f) = empty .
  eq fv(()**(d)[] I f) = d .
  eq fv(()**(d)<> I f) = d .

----------------------------
----- Clock variables ------
----------------------------

  op clkVars : Set{ClkReset} -> Set{Clock} .
  eq clkVars((Λ, c := NB)) = c, clkVars(Λ) .
  eq clkVars(empty) = empty .

----------------------------
----- Structural Rules -----
----------------------------

  eq (X Ψ), (X Ψ') = X (Ψ, Ψ') .
 ceq (Λ . Ψ), (Λ' . Ψ') = union(Λ, Λ') . (Ψ, Ψ') 
  if VS := clkVars(Λ) /\ VS' := clkVars(Λ') 
  /\ intersection(VS, VS') == empty 
  /\ intersection(VS, fv(Ψ')) == empty 
  /\ intersection(VS', fv(Ψ)) == empty .

 ceq (Λ . (Ψ, (Λ' . Ψ'))) = union(Λ, Λ') . (Ψ, Ψ') 
  if VS := clkVars(Λ) /\ VS' := clkVars(Λ') 
  /\ intersection(VS, VS') == empty 
  /\ intersection(VS', fv(Ψ)) == empty .

  eq (Λ . (Ψ, (Λ . Ψ'))) = Λ . (Ψ, Ψ') .
  eq (Λ . Ψ), (Λ . Ψ') = Λ . (Ψ, Ψ') .

--- this reduction is suppose to be applied to non-clock judgements only
--- only needed for the OC case
 ceq (Λ . Ψ), Φ = Λ . (Ψ, Φ) 
  if Φ :: NonClockJudgement
  /\ intersection(clkVars(Λ), fv(Φ)) == empty . 
endfm

fmod GEN-AUX is
  pr NAT .
  pr META-LEVEL .
  pr CONVERSION .

  vars S TY : String .
  var N : Nat .

  op idGen : String Nat -> Nat .
  eq idGen(S, N) = downTerm(qid("$" + S + string(N, 10) + ":Nat"), 0) .

  op idGen : String String Nat -> Qid .
  eq idGen(S, TY, N) = qid("$" + S + string(N, 10) + ":" + TY) .
endfm

fmod DECOMP-CONF is
  sort DecompConf .
endfm

view DecompConf from TRIV to DECOMP-CONF is
  sort Elt to DecompConf .
endv

mod DECOMP-RULES-AUX is
  pr CLOCK .
  pr GEN-AUX .
  pr DECOMP-CONF .
  pr JUDGEMENTS .
  pr STRING .

  var I : Interval .
  vars N N' N'' M M' : Nat .
  vars N1 N2 : String .
  vars f f1 f2 : Formula .
  vars c c' d d' : Clock .
  vars B B' BL BL' MB MB' : Bool .
  vars Ψ Ψ' C L C' L' : Set{Judgement} .
  vars GOALS INV NXT JS JS' : Set{Judgement} .
  vars Φ Φ' : NeSet{Judgement} .
  vars Λ Λ' : Set{ClkReset} .
  vars NB NM : Number .
  vars CS CS1 CS2 : Set{Clock} .
  vars MAP MAP' MAP'' : Map .
  var CP : CIntvPred .
  vars GMAP GMAP' GMAP'' GMAP1 GMAP2 : GMap .

--- Judgement, Invariant, Expanded intermediate goals, Counter, Counter
  op <_::_::_::_,_> : Set{Judgement} Set{Judgement} Set{Judgement} Nat Nat -> DecompConf [ctor] .
  op <_::_::_::_> : Set{Judgement} Set{Judgement} Set{Judgement} Nat -> DecompConf [ctor] . --- for simple
  op wrong : -> DecompConf [ctor] .

  op Num : String -> Number [ctor] .
  op infty : -> Number [ctor] .
  op clk : Nat -> Clock [ctor] .
  op e-clk : -> Clock [ctor] .
  op oc : Nat -> Bool [ctor] .

  sort GenResult .
  op {_,_} : Clock Nat -> GenResult [ctor] .
  op {_,_} : Bool Nat -> GenResult [ctor] .

  op clkGen : Set{ClkReset} Set{Clock} Number Nat -> GenResult .
  --- ceq clkGen((Λ, c := NM), CS, NM, N) = {c, N} if not (c in CS) .
  ---  eq clkGen(Λ, CS, NM, N) = {clk(N), N + 1} [owise] .
  --- currently create new fresh clock variables every time
  eq clkGen(Λ, CS, NM, N) = {clk(N), N + 1} .
  --- eq clkGen(Λ, CS, NM, N) = {downTerm(idGen("clk", "Clock", N), e-clk), N + 1} .

  op clkFreshGen : Nat -> GenResult .
  eq clkFreshGen(N) = {clk(N), N + 1} .

  op ocGen : Set{Judgement} Nat -> GenResult .
  eq ocGen((Ψ, lc?(B)), N) = {B, N} .
  eq ocGen(Ψ, N) = {oc(N), N + 1} [owise] .
  --- eq ocGen(Ψ, N) = {downTerm(idGen("oc", "Bool", N), true), N + 1} [owise] .

  sorts CMap CMapGenResult .

  op none : -> CMap [ctor] .
  op _:>_ : Judgement Nat -> CMap [ctor prec 40] .
  op _;_ : CMap CMap -> CMap [ctor assoc comm id: none] .

  op _in_ : Judgement CMap -> Bool .
  eq Ψ in (Ψ :> N ; CMAP) = true .
  eq Ψ in CMAP = false [owise] .

  op getCMap : Judgement CMap -> CMap .
  eq getCMap(Ψ, (Ψ :> N) ; CMAP) = (Ψ :> N + 1) ; CMAP .
  eq getCMap(Ψ, CMAP) = Ψ :> 1 ; CMAP [owise] .

  var CMAP : CMap .

--- getIntvSize simple version

  op getIntvSize : Interval -> Nat .
  eq getIntvSize(| B, Num(N1), Num(N2), B' |) = rat(ceiling(float(N2) / (float(N2) - float(N1)))) .

  op getIntvSanity : Set{Judgement} -> Nat .
  eq getIntvSanity((c)-(d)[] I f) = getIntvSize(I) .
  eq getIntvSanity((c)-()[] I f) = getIntvSize(I) .
  eq getIntvSanity((c)-(d)<> I f) = getIntvSize(I) .
  eq getIntvSanity((c)-()<> I f) = getIntvSize(I) .

--- for testing purpose (hard-coded for 2)
---  ceq < C, Λ . (L, X (C', Λ' . L')) :: N, M > = wrong
---   if CMAP := getCount(L', getCount(L, none)) 
---   /\ not sanity(CMAP) .

 ceq < C, Λ . (L, X (C', Λ' . L')) :: INV :: GOALS :: N > = wrong
  if CMAP := getCount(L', getCount(L, none)) 
  /\ not sanity(CMAP) .

  op sanity : CMap -> Bool .
  eq sanity((Ψ :> N ; CMAP)) = N <= getIntvSanity(Ψ) and sanity(CMAP) .
  eq sanity(none) = true . 

  op getCount : Set{Judgement} CMap -> CMap .
 ceq getCount((CP, Ψ), CMAP) = getCount(Ψ, getCMap(Ψ', CMAP))
  if {Ψ', GMAP} := getPattern(CP) .
 ceq getCount((Φ, Ψ), CMAP) = getCount(Ψ, CMAP) 
  if not Φ :: CIntvPred .
  eq getCount(empty, CMAP) = CMAP .

--- make template and then matching

  sorts Map GMap .

  op none : -> Map [ctor] .
  op _->_ : Clock Clock -> Map [ctor prec 40] .
  op _->_ : Bool Bool -> Map [ctor prec 40] .
  op _;_ : Map Map -> Map [ctor assoc comm id: none] .

  op _::_ : Map Nat -> GMap [ctor] .

  sorts JPattern BPattern CPattern .
  op {_,_} : Set{Judgement} GMap -> JPattern [ctor] .
  op {_,_} : Bool GMap -> BPattern [ctor] .
  op {_,_} : Set{ClkReset} GMap -> CPattern [ctor] .

  sort ClkInfo .
  op {_,_} : Clock GMap -> ClkInfo .

  op getClk : Clock GMap -> ClkInfo .
  eq getClk(c, (c -> c') ; MAP :: M) = {c', (c -> c') ; MAP :: M} .
 ceq getClk(c, MAP :: M) = {c', (c -> c'); MAP :: M + 1}
  if c' := clk(idGen("clk", M)) [owise] .

  op getJudgementPattern : JPattern -> Set{Judgement} .
  eq getJudgementPattern({Ψ, GMAP}) = Ψ .

  op getPattern : Set{Judgement} GMap -> JPattern .
  op getPattern : Set{Judgement} -> JPattern .
  eq getPattern(Ψ) = getPattern(Ψ, none :: 0) .

  eq getPattern(*, GMAP) = {*, GMAP} .
  eq getPattern([f], GMAP) = {[f], GMAP} .
 ceq getPattern((Φ, Φ'), GMAP) = {(JS, JS'), GMAP''} 
  if {JS, GMAP'} := getPattern(Φ, GMAP) 
  /\ {JS', GMAP''} := getPattern(Φ', GMAP') .
 ceq getPattern(c <= NB, GMAP) = {c' <= NB, GMAP'}
  if {c', GMAP'} := getClk(c, GMAP) .
 ceq getPattern(c >= NB, GMAP) = {c' >= NB, GMAP'}
  if {c', GMAP'} := getClk(c, GMAP) .
 ceq getPattern(c <=[B] NB, GMAP) = {c' <=[B'] NB, GMAP''}
  if {c', GMAP'} := getClk(c, GMAP)
  /\ {B', GMAP''} := getBPattern(B, GMAP') .
 ceq getPattern(c >=[B] NB, GMAP) = {c' >=[B'] NB, GMAP''}
  if {c', GMAP'} := getClk(c, GMAP)
  /\ {B', GMAP''} := getBPattern(B, GMAP') .
 ceq getPattern(X Ψ, GMAP) = {X Ψ', GMAP'}
  if {Ψ', GMAP'} := getPattern(Ψ, GMAP) .
 ceq getPattern(Λ . Ψ, GMAP) = {Λ' . Ψ', GMAP''}
  if {Λ', GMAP'} := getCPattern(Λ, GMAP)
  /\ {Ψ', GMAP''} := getPattern(Ψ, GMAP') .
 ceq getPattern((c)-()[] I f, GMAP) = {(c')-()[] I f, GMAP'}
  if {c', GMAP'} := getClk(c, GMAP) .
 ceq getPattern((c)-(d)[] I f, GMAP) = {(c')-(d')[] I f, GMAP''}
  if {c', GMAP'} := getClk(c, GMAP) /\ {d', GMAP''} := getClk(d, GMAP') .
 ceq getPattern((c)-()<> I f, GMAP) = {(c')-()<> I f, GMAP'}
  if {c', GMAP'} := getClk(c, GMAP) .
 ceq getPattern((c)-(d)<> I f, GMAP) = {(c')-(d')<> I f, GMAP''}
  if {c', GMAP'} := getClk(c, GMAP) /\ {d', GMAP''} := getClk(d, GMAP') .
 ceq getPattern((c)==()[] I f, GMAP) = {(c')==()[] I f, GMAP'}
  if {c', GMAP'} := getClk(c, GMAP) .
 ceq getPattern((c)==(d)[] I f, GMAP) = {(c')==(d')[] I f, GMAP''}
  if {c', GMAP'} := getClk(c, GMAP) /\ {d', GMAP''} := getClk(d, GMAP') .
  eq getPattern(()**()[] I f, GMAP) = {()**()[] I f, GMAP} .
 ceq getPattern(()**(d)[] I f, GMAP) = {()**(d')[] I f, GMAP'}
  if {d', GMAP'} := getClk(d, GMAP) .
 ceq getPattern((B,c)-()[] I f, GMAP) = {(B',c')-()[] I f, GMAP''}
  if {c', GMAP'} := getClk(c, GMAP)
  /\ {B', GMAP''} := getBPattern(B, GMAP') .
 ceq getPattern((B,c)-(d,B')[] I f, GMAP) = {(MB,c')-(d',MB')[] I f, GMAP2}
  if {c', GMAP'} := getClk(c, GMAP) /\ {d', GMAP''} := getClk(d, GMAP')
  /\ {MB, GMAP1} := getBPattern(B, GMAP'') 
  /\ {MB', GMAP2} := getBPattern(B', GMAP1) .
 ceq getPattern((B,c)-()<> I f, GMAP) = {(B',c')-()<> I f, GMAP''}
  if {c', GMAP'} := getClk(c, GMAP)
  /\ {B', GMAP''} := getBPattern(B, GMAP') .
 ceq getPattern((B,c)-(d,B')<> I f, GMAP) = {(MB,c')-(d',MB')<> I f, GMAP2}
  if {c', GMAP'} := getClk(c, GMAP) /\ {d', GMAP''} := getClk(d, GMAP')
  /\ {MB, GMAP1} := getBPattern(B, GMAP'') 
  /\ {MB', GMAP2} := getBPattern(B', GMAP1) .
 ceq getPattern(lc?(B), GMAP) = {lc?(B'), GMAP'}
  if {B', GMAP'} := getBPattern(B, GMAP) .
  eq getPattern(empty, GMAP) = {empty, GMAP} .
  
  op getCPattern : Set{ClkReset} GMap -> CPattern .
 ceq getCPattern((c := NB, Λ), (c -> c') ; MAP :: M) = {(c' := NB, Λ'), GMAP}
  if {Λ', GMAP} := getCPattern(Λ, (c -> c') ; MAP :: M) .
 ceq getCPattern((c := NB, Λ), MAP :: M) = {(clk(idGen("clk", M)) := NB, Λ'), GMAP}
  if {Λ', GMAP} := getCPattern(Λ, (c -> clk(idGen("clk", M))) ; MAP :: M + 1) [owise] .
  eq getCPattern(empty, GMAP) = {empty, GMAP} .

  op getBPattern : Bool GMap -> BPattern .
 ceq getBPattern(B and B', GMAP) = {MB and MB', GMAP''}
  if {MB, GMAP'} := getBPattern(B, GMAP) /\ {MB', GMAP''} := getBPattern(B', GMAP') .
 ceq getBPattern(B or B', GMAP) = {MB or MB', GMAP''}
  if {MB, GMAP'} := getBPattern(B, GMAP) /\ {MB', GMAP''} := getBPattern(B', GMAP') .
 ceq getBPattern(B xor B', GMAP) = {MB xor MB', GMAP''}
  if {MB, GMAP'} := getBPattern(B, GMAP) /\ {MB', GMAP''} := getBPattern(B', GMAP') .
 ceq getBPattern(B implies B', GMAP) = {MB implies MB', GMAP''}
  if {MB, GMAP'} := getBPattern(B, GMAP) /\ {MB', GMAP''} := getBPattern(B', GMAP') .
 ceq getBPattern(not B, GMAP) = {not MB, GMAP'}
  if {MB, GMAP'} := getBPattern(B, GMAP) .
  eq getBPattern(true, GMAP) = {true, GMAP} .
  eq getBPattern(false, GMAP) = {false, GMAP} .
  eq getBPattern(oc(N), (oc(N) -> B) ; MAP :: M) 
   = {B, (oc(N) -> B) ; MAP :: M} .
  eq getBPattern(oc(N), MAP :: M) 
   = {oc(idGen("oc", M)), (oc(N) -> oc(idGen("oc", M))) ; MAP :: M + 1} [owise] .

--- Replace auxiliary oc variables in interval-sequence judgements.

  op getRealJudgement : Set{Judgement} -> Set{Judgement} .
  op getRealJudgementAux : Set{Judgement} GMap -> JPattern .
 ceq getRealJudgement(Ψ) = Ψ'
  if {Ψ', GMAP} := getRealJudgementAux(Ψ, none :: 0) .

  eq getRealJudgementAux(*, GMAP) = {*, GMAP} .
  eq getRealJudgementAux([f], GMAP) = {[f], GMAP} .
 ceq getRealJudgementAux((Φ, Φ'), GMAP) = {(JS, JS'), GMAP''} 
  if {JS, GMAP'} := getRealJudgementAux(Φ, GMAP) 
  /\ {JS', GMAP''} := getRealJudgementAux(Φ', GMAP') .
 ceq getRealJudgementAux(c <=[B] NB, GMAP) = {c <=[B'] NB, GMAP'}
  if {B', GMAP'} := getBPattern(B, GMAP) .
 ceq getRealJudgementAux(c >=[B] NB, GMAP) = {c >=[B'] NB, GMAP'}
  if {B', GMAP'} := getBPattern(B, GMAP) .
 ceq getRealJudgementAux(X Ψ, GMAP) = {X Ψ', GMAP'}
  if {Ψ', GMAP'} := getRealJudgementAux(Ψ, GMAP) .
 ceq getRealJudgementAux(Λ . Ψ, GMAP) = {Λ . Ψ', GMAP'}
  if {Ψ', GMAP'} := getRealJudgementAux(Ψ, GMAP) .
 ceq getRealJudgementAux((B,c)-()[] I f, GMAP) = {(B',c)-()[] I f, GMAP'}
  if {B', GMAP'} := getBPattern(B, GMAP) .
 ceq getRealJudgementAux((B,c)-(d,B')[] I f, GMAP) = {(MB,c)-(d,MB')[] I f, GMAP''}
  if {MB, GMAP'} := getBPattern(B, GMAP) 
  /\ {MB', GMAP''} := getBPattern(B', GMAP') .
 ceq getRealJudgementAux((B,c)-()<> I f, GMAP) = {(B',c)-()<> I f, GMAP'}
  if {B', GMAP'} := getBPattern(B, GMAP) .
 ceq getRealJudgementAux((B,c)-(d,B')<> I f, GMAP) = {(MB,c)-(d,MB')<> I f, GMAP''}
  if {MB, GMAP'} := getBPattern(B, GMAP) 
  /\ {MB', GMAP''} := getBPattern(B', GMAP') .
 ceq getRealJudgementAux(lc?(B), GMAP) = {lc?(B'), GMAP'}
  if {B', GMAP'} := getBPattern(B, GMAP) .
  eq getRealJudgementAux(empty, GMAP) = {empty, GMAP} .

-----------------------
------ reduction ------
-----------------------

  ops tt ff : -> Judgement [ctor] .

  eq c <= infty = tt .
  eq c >= infty = ff .
  eq Φ, tt = Φ .

------------------------------
--- contradiction checking ---
------------------------------

  op isContradiction : Set{Judgement} -> Bool .
  eq isContradiction((Ψ, ff)) = true .
  eq isContradiction(Ψ) = false [owise] .

endm

view GMap from TRIV to DECOMP-RULES-AUX is
  sort Elt to GMap .
endv

mod DECOMP-RULES-COMPLEX is
  pr DECOMP-RULES-AUX .

  vars N N' N'' M M' : Nat .
  vars f f1 f2 : Formula .
  var I : Interval .
  vars c d : Clock .
  vars B B' BL BL' : Bool .
  vars Ψ C L C' L' NXT INV GOALS : Set{Judgement} .
  var Φ : NeSet{Judgement} .
  vars Λ Λ' : Set{ClkReset} .
  var NM : Number .
  vars CS CS1 CS2 : Set{Clock} .
  var CMAP : CMap .

-----------------------
------- common --------
-----------------------
  
  rl [and]          : < C, Λ . (L, [f1 /\ f2], X NXT) :: INV :: GOALS :: N, M > => < C, Λ . (L, [f1], [f2], X NXT) :: INV :: GOALS :: N, M > .
  rl [or-le]        : < C, Λ . (L, [f1 \/ f2], X NXT) :: INV :: GOALS :: N, M > => < C, Λ . (L, [f1], X NXT) :: INV :: GOALS :: N, M > .
  rl [or-ri]        : < C, Λ . (L, [f1 \/ f2], X NXT) :: INV :: GOALS :: N, M > => < C, Λ . (L, [f2], X NXT) :: INV :: GOALS :: N, M > .
  rl [until-1]      : < C, Λ . (L, [f1 U f2] , X NXT) :: INV :: GOALS :: N, M > => < C, Λ . (L, [f1], [f2], X NXT) :: INV :: GOALS :: N, M > .
  rl [until-2]      : < C, Λ . (L, [f1 U f2] , X NXT) :: INV :: GOALS :: N, M > => < C, Λ . (L, [f1], X ([f1 U f2]), X NXT) :: INV :: GOALS :: N, M > .
  rl [release-1]    : < C, Λ . (L, [f1 R f2] , X NXT) :: INV :: GOALS :: N, M > => < C, Λ . (L, [f1], X NXT) :: INV :: GOALS :: N, M > .
  rl [release-2]    : < C, Λ . (L, [f1 R f2] , X NXT) :: INV :: GOALS :: N, M > => < C, Λ . (L, [f2], X ([f1 R f2]), X NXT) :: INV :: GOALS :: N, M > .
  rl [release-3]    : < C, Λ . (L, [f1 R f2] , X NXT) :: INV :: GOALS :: N, M > => < C, Λ . (L, [f2], X (*), X NXT) :: INV :: GOALS :: N, M > .

