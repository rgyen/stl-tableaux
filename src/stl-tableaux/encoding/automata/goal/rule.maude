----- eventually ------
-----------------------

  crl [eventually-ipstl] : 
     < C, Λ . (L, [<> I f], X (C', Λ' . L')) :: INV :: GOALS :: N, M > 
  => < C, Λ . (L, ((c := Num("0.0")) . (lc?(B), (B,c)-()<> I f)), X (C', Λ' . L')) :: INV :: (GOALS, [<> I f]) :: N', M' > 
  if {B, N'} := ocGen(L, N) /\ {c, M'} := clkGen(Λ, clkVars(Λ), Num("0.0"), M) .

  crl [eventually-up-1] : 
     < C, Λ . (L, (B,c)-()<> I f, X (C', Λ' . L')) :: INV :: GOALS :: N, M > 
  => < C, Λ . (L, X (C', Λ' . L'), X (c <=[(not B) or B'] sup(I), (d := Num("0.0")) . (lc?(B'), (B,c)-(d, not B')<> I f))) :: INV :: (GOALS, (B,c)-()<> I f) :: N', M' >
  if {B', N'} := ocGen(L', N) /\ {d, M'} := clkGen(Λ, union(union(fv(L'), clkVars(Λ')), c), Num("0.0"), M) .

  crl [eventually-up-2] : 
     < C, Λ . (L, (B,c)-()<> I f, X (C', Λ' . L')) :: INV :: GOALS :: N, M > 
  => < C, Λ . (L, [f], c <=[(not B) or BL] sup(I), lc?(BL), 
                X (C', Λ' . L'), 
                X (c >=[B and (not B')] inf(I), (c := inf(I), d := Num("0.0")) . (lc?(B'), (B',c)-(d, not B')<> I f))) :: INV :: (GOALS, (B,c)-()<> I f) :: N'', M' >
  if {BL, N'} := ocGen(L, N) /\ {B', N''} := ocGen(L', N') /\ {d, M'} := clkGen(Λ, union(union(fv(L'), clkVars(Λ')), c), Num("0.0"), M) .

  crl [eventually-updown-1] : 
     < C, Λ . (L, (B,c)-(d,B')<> I f, X (C', Λ' . L')) :: INV :: GOALS :: N, M > 
  => < C, Λ . (L, lc?(BL), X (C', Λ' . L'), 
                X (c <=[(not B) or (BL')] sup(I), (empty) . (lc?(BL'), (B,c)-(d,B')<> I f))) :: INV :: (GOALS, (B,c)-(d,B')<> I f) :: N'', M >
  if {BL, N'} := ocGen(L, N) /\ {BL', N''} := ocGen(L', N') .

  crl [eventually-updown-2] : 
     < C, Λ . (L, (B,c)-(d,B')<> I f, X (C', Λ' . L')) :: INV :: GOALS :: N, M > 
  => < C, Λ . (L, [f], c <=[(not B) or BL] sup(I), lc?(BL), X (C', Λ' . L'), 
                X (c >=[B and (not BL')] inf(I), d <=[B' and BL'] inf(I), 
                  (c := inf(I)) . (lc?(BL'), (BL',c)-(d,B')<> I f))) :: INV :: (GOALS, (B,c)-(d,B')<> I f) :: N'', M >
  if {BL, N'} := ocGen(L, N) /\ {BL', N''} := ocGen(L', N') .

  crl [eventually-updown-3] : 
     < C, Λ . (L, (B,c)-(d,B')<> I f, X (C', Λ' . L')) :: INV :: GOALS :: N, M > 
  => < C, Λ . (L, [f], c <=[(not B) or BL] sup(I), lc?(BL), X (C', Λ' . L'), 
                X (c >=[B and (not BL')] inf(I), d >=[(not B') or (not BL')] inf(I), lc?(BL'))) :: INV :: (GOALS, (B,c)-(d,B')<> I f) :: N'', M >
  if {BL, N'} := ocGen(L, N) /\ {BL', N''} := ocGen(L', N') .
endm

mod DECOMP-RULES-SIMPLE is
  pr DECOMP-RULES-AUX .

  vars N N' N'' M M' : Nat .
  vars f f1 f2 : Formula .
  var I : Interval .
  vars c d : Clock .
  vars B B' BL BL' : Bool .
  vars Ψ C L C' L' INV GOALS : Set{Judgement} .
  var Φ : NeSet{Judgement} .
  vars Λ Λ' : Set{ClkReset} .
  var NM : Number .
  vars CS CS1 CS2 : Set{Clock} .
  var CMAP : CMap .

