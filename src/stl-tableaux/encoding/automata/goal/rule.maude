unify 
[($oc0:Bool,$clk0:Clock)-($clk1:Clock,true xor $oc1:Bool)[]| true,Num("1.0"),Num("2.0"),true | p(1)]
=?
[($oc1:Bool,$clk0:Clock)-($clk1:Clock,true xor $oc1:Bool)[]| true,Num("1.0"),Num("2.0"),true | p(1)] .

