------- common --------
-----------------------

  crl [and-simp] : 
     < C, Λ . (L, [f1 /\ f2], X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f1], [f2], X (C', Λ' . L')) :: INV :: (GOALS, [f1 /\ f2]) :: M > 
  if not isContradiction((C, C')) .
  
  crl [or-le-simp] : 
     < C, Λ . (L, [f1 \/ f2], X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f1], X (C', Λ' . L')) :: INV :: (GOALS, [f1 \/ f2]) :: M > 
  if not isContradiction((C, C')) .
  
  crl [or-ri-simp] : 
     < C, Λ . (L, [f1 \/ f2], X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f2], X (C', Λ' . L')) :: INV :: (GOALS, [f1 \/ f2]) :: M > 
  if not isContradiction((C, C')) .
  
  crl [until-1-simp] : 
     < C, Λ . (L, [f1 U f2] , X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f1], [f2], X (C', Λ' . L')) :: INV :: (GOALS, [f1 U f2]) :: M > 
  if not isContradiction((C, C')) .

  crl [until-2-simp] : 
     < C, Λ . (L, [f1 U f2] , X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f1], X ([f1 U f2]), X (C', Λ' . L')) :: INV :: (GOALS, [f1 U f2]) :: M > 
  if not isContradiction((C, C')) .
  
  crl [release-1-simp] : 
     < C, Λ . (L, [f1 R f2] , X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f1], X (C', Λ' . L')) :: INV :: (GOALS, [f1 R f2]) :: M > 
  if not isContradiction((C, C')) .
  
  crl [release-2-simp] : 
     < C, Λ . (L, [f1 R f2] , X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f2], X ([f1 R f2]), X (C', Λ' . L')) :: INV :: (GOALS, [f1 R f2]) :: M > 
  if not isContradiction((C, C')) .
  
  crl [release-3-simp] : 
     < C, Λ . (L, [f1 R f2] , X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, [f2], X (*), X (C', Λ' . L')) :: INV :: (GOALS, [f1 R f2]) :: M > 
  if not isContradiction((C, C')) .

