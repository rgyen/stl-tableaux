------- always --------
-----------------------

  crl [always-ipstl] : 
     < C, Λ . (L, [[] I f], X (C', Λ' . L')) :: INV :: GOALS :: N, M > 
  => < C, Λ . (L, ((c := Num("0.0")) . (lc?(B), (B,c)-()[] I f)), X (C', Λ' . L')) :: INV :: (GOALS, [[] I f]) :: N', M' > 
  if {B, N'} := ocGen(L, N) /\ {c, M'} := clkGen(Λ, clkVars(Λ), Num("0.0"), M) .

  rl [always-up-1] : 
     < C, Λ . (L, (B,c)-()[] I f, X (C', Λ' . L')) :: INV :: GOALS :: N, M > 
  => < C, Λ . (L, X (c <=[not B] inf(I), *), X (C', Λ' . L')) :: INV :: (GOALS, (B,c)-()[] I f) :: N, M > .

  crl [always-up-2] : 
     < C, Λ . (L, (B,c)-()[] I f, X (C', Λ' . L')) :: INV :: GOALS :: N, M >
  => < C, Λ . (L, [f], X (c >=[B] inf(I), *), X (C', Λ' . L')) :: (INV, c <=[(not B) or BL] inf(I), lc?(BL)) :: (GOALS, (B,c)-()[] I f) :: N', M >
  if {BL, N'} := ocGen(L, N) .

  crl [always-up-3] : 
     < C, Λ . (L, (B,c)-()[] I f, X (C', Λ' . L')) :: INV :: GOALS :: N, M > 
  => < C, Λ . (L, X (c <=[(not B) or B'] inf(I), (d := Num("0.0")) . (lc?(B'), (B,c)-(d, not B')[] I f)), X (C', Λ' . L')) :: INV :: (GOALS, (B,c)-()[] I f) :: N', M' >
  if {B', N'} := ocGen(L', N) /\ {d, M'} := clkGen(Λ, union(union(fv(L'), clkVars(Λ')), c), Num("0.0"), M) .

  crl [always-up-4] : 
     < C, Λ . (L, (B,c)-()[] I f, X (C', Λ' . L')) :: INV :: GOALS :: N, M >
  => < C, Λ . (L, [f], 
            X (c >=[B and (not B')] inf(I), (c := inf(I), d := Num("0.0")) . (lc?(B'), (B',c)-(d, not B')[] I f)), X (C', Λ' . L')) 
            :: (INV, c <=[(not B) or BL] inf(I), lc?(BL)) :: (GOALS, (B,c)-()[] I f) :: N'', M' >
  if {BL, N'} := ocGen(L, N) /\ {B', N''} := ocGen(L', N') 
  /\ {d, M'} := clkGen(Λ, union(union(fv(L'), clkVars(Λ')), c), Num("0.0"), M) .

  crl [always-updown-1] : 
     < C, Λ . (L, (B,c)-(d,B')[] I f, X (C', Λ' . L')) :: INV :: GOALS :: N, M > 
  => < C, Λ . (L, X (c <=[(not B) or BL] inf(I), lc?(BL), (B,c)-(d,B')[] I f), X (C', Λ' . L')) :: INV :: (GOALS, (B,c)-(d,B')[] I f) :: N', M > 
  if  {BL, N'} := ocGen(L', N) . 

  rl [always-updown-2] : 
     < C, Λ . (L, (B,c)-(d,B')[] I f, X (C', Λ' . L')) :: INV :: GOALS :: N, M > 
  => < C, Λ . (L, X (c <=[not B] inf(I), *), X (C', Λ' . L')) :: INV :: (GOALS, (B,c)-(d,B')[] I f) :: N, M > .

  crl [always-updown-3] : 
     < C, Λ . (L, (B,c)-(d,B')[] I f, X (C', Λ' . L')) :: INV :: GOALS :: N, M > 
  => < C, Λ . (L, [f], X (c >=[B] inf(I), *), X (C', Λ' . L')) 
              :: (INV, c <=[(not B) or BL] inf(I), lc?(BL)) :: (GOALS, (B,c)-(d,B')[] I f) :: N', M >
  if {BL, N'} := ocGen(L, N) .

  crl [always-updown-4] : 
     < C, Λ . (L, (B,c)-(d,B')[] I f, X (C', Λ' . L')) :: INV :: GOALS :: N, M >
  => < C, Λ . (L, [f], 
            X (c >=[B and (not BL')] inf(I), d <=[B' and BL'] sup(I), 
                (c := inf(I)) . (lc?(BL'), (BL',c)-(d, B')[] I f)), X (C', Λ' . L')) 
            :: (INV, c <=[(not B) or BL] inf(I), lc?(BL)) :: (GOALS, (B,c)-(d,B')[] I f) :: N'', M >
  if {BL, N'} := ocGen(L, N) /\ {BL', N''} := ocGen(L', N') .

  crl [always-updown-5] : 
     < C, Λ . (L, (B,c)-(d,B')[] I f, X (C', Λ' . L')) :: INV :: GOALS :: N, M >
  => < C, Λ . (L, [f], 
            X (lc?(BL'), c >=[B and (not BL')] inf(I), d >=[(not B') or (not BL')] sup(I)), X (C', Λ' . L')) 
            :: (INV, c <=[(not B) or BL] inf(I), lc?(BL)) :: (GOALS, (B,c)-(d,B')[] I f) :: N'', M >
  if {BL, N'} := ocGen(L, N) /\ {BL', N''} := ocGen(L', N') .

