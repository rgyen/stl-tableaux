     < C, Λ . (L, (c)-()[] I f, X (C', Λ' . L')) :: INV :: GOALS :: M > 
  => < C, Λ . (L, X (c <= inf(I), (d := Num("0.0")) . ((c)-(d)[] I f)), X (C', Λ' . L')) :: INV :: (GOALS, (c)-()[] I f) :: M' >
  if {d, M'} := clkFreshGen(M) /\ not isContradiction((C, C')) .

