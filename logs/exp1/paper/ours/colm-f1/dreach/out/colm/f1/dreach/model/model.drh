        d/dt[y] = 0.2 * x - 0.1 * x * x * x - 0.02 * y + 0.01;

    jump:
        // mode_id_11 -> mode_id_8 (12 -> 9)
            (and (clk0 >= 10.0) (and (clk2 >= 20.0) (clk1 >= 20.0))) ==> @9(and (clk0' = clk0) (clk1' = clk1) (gClk' = gClk) (x' = x) (y' = y) (clk4' = clk4) (clk2' = 20.0) (clk3' = 0.0));

        // mode_id_11 -> mode_id_7 (12 -> 8)
            (and (clk0 >= 10.0) (and (clk2 >= 20.0) (clk1 >= 20.0))) ==> @8(and (clk0' = clk0) (clk1' = clk1) (gClk' = gClk) (x' = x) (y' = y) (clk4' = clk4) (clk2' = 20.0) (clk3' = 0.0));

        // mode_id_11 -> mode_id_12 (12 -> 13)
            (and (clk0 >= 10.0) (and (clk2 >= 20.0) (clk1 <= 20.0))) ==> @13(and (clk0' = 10.0) (clk1' = clk1) (gClk' = gClk) (x' = x) (y' = y) (clk4' = 0.0) (clk2' = 20.0) (clk3' = 0.0));

        // mode_id_11 -> mode_id_2 (12 -> 3)
            (and (clk0 >= 10.0) (and (clk2 >= 20.0) (clk1 <= 20.0))) ==> @3(and (clk0' = 10.0) (clk1' = clk1) (gClk' = gClk) (x' = x) (y' = y) (clk4' = 0.0) (clk2' = 20.0) (clk3' = 0.0));

        // mode_id_11 -> mode_id_5 (12 -> 6)
            (and (clk0 >= 10.0) (and (clk2 >= 20.0) (clk1 <= 20.0))) ==> @6(and (clk0' = 10.0) (clk1' = clk1) (gClk' = gClk) (x' = x) (y' = y) (clk4' = 0.0) (clk2' = 20.0) (clk3' = 0.0));

    // end mode_id_11
}

// mode_id_12
{
    mode 13;
    invt:
        (and (and (x <= 1000.0) (and (gClk <= 50.0) (-1000.0 <= y))) (and (-1000.0 <= x) (and (gClk >= 0.0) (y <= 1000.0))));
    flow:
        d/dt[clk1] = 1.0;
        d/dt[clk0] = 1.0;
        d/dt[clk3] = 1.0;
        d/dt[clk2] = 1.0;
        d/dt[clk4] = 1.0;
        d/dt[gClk] = 1.0;
        d/dt[x] = 0.1 * y;
        d/dt[y] = 0.2 * x - 0.1 * x * x * x - 0.02 * y + 0.01;

    jump:
        // mode_id_12 -> mode_id_5 (13 -> 6)
            (and (clk0 >= 10.0) (and (clk1 <= 20.0) (clk2 <= 28.0))) ==> @6(and (clk0' = 10.0) (clk1' = clk1) (gClk' = gClk) (x' = x) (y' = y) (clk4' = 0.0) (clk2' = clk2) (clk3' = clk3));

        // mode_id_12 -> mode_id_8 (13 -> 9)
            (clk2 <= 28.0) ==> @9(and (clk0' = clk0) (clk1' = clk1) (gClk' = gClk) (x' = x) (y' = y) (clk4' = clk4) (clk2' = clk2) (clk3' = clk3));

        // mode_id_12 -> mode_id_2 (13 -> 3)
            (and (clk0 >= 10.0) (and (clk1 <= 20.0) (clk2 <= 28.0))) ==> @3(and (clk0' = 10.0) (clk1' = clk1) (gClk' = gClk) (x' = x) (y' = y) (clk4' = 0.0) (clk2' = clk2) (clk3' = clk3));

        // mode_id_12 -> mode_id_7 (13 -> 8)
            (clk2 <= 28.0) ==> @8(and (clk0' = clk0) (clk1' = clk1) (gClk' = gClk) (x' = x) (y' = y) (clk4' = clk4) (clk2' = clk2) (clk3' = clk3));

    // end mode_id_12
}
// end modes

init:
@11 (and (and (and (clk2 = 0.0) (x >= -0.5)) (and (x <= -0.4) (and (clk0 = 0.0) (y <= -0.4)))) (and (and (y >= -0.5) (gClk = 0.0)) (and (clk1 = 0.0) (and (clk3 = 0.0) (clk4 = 0.0)))));

goal:
@5 true;
