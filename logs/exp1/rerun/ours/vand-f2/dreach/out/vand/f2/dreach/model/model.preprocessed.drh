[ 0, 100 ] x;
[ 0, 100 ] y;
[0,70] time;
[0,100] gClk;
{
    mode 1;
    invt:
        (and (and (0.0 <= x) (and (0.0 <= y) (y <= 100.0))) (and (and (x <= 40.0 + 1.0) (gClk >= 0.0)) (and (x <= 100.0) (gClk <= 100.0))));
    flow:
        d/dt[gClk] = 1.0;
        d/dt[y] = -0.15 * (x * x * y + x + y);
        d/dt[x] = 0.1 * y;
    jump:
            (true) ==> @4(and (gClk' = gClk) (x' = x) (y' = y));
            (gClk >= 100.0) ==> @3(and (gClk' = gClk) (x' = x) (y' = y));
}
{
    mode 2;
    invt:
        (and (gClk >= 0.0) (gClk <= 100.0));
    flow:
        d/dt[y] = 0.0;
        d/dt[x] = 0.0;
        d/dt[gClk] = 1.0;
    jump:
            (true) ==> @4(and (gClk' = 0.0) (x' = x) (y' = y));
            (true) ==> @1(and (gClk' = 0.0) (x' = x) (y' = y));
}
{
    mode 3;
    invt:
        (and (and (0.0 <= x) (and (0.0 <= y) (y <= 100.0))) (and (gClk >= 0.0) (and (x <= 100.0) (gClk <= 100.0))));
    flow:
        d/dt[gClk] = 1.0;
        d/dt[y] = -0.15 * (x * x * y + x + y);
        d/dt[x] = 0.1 * y;
    jump:
}
{
    mode 4;
    invt:
        (and (and (0.0 <= x) (and (0.0 <= y) (y <= 100.0))) (and (and (gClk >= 0.0) (x <= 100.0)) (and (gClk <= 100.0) (y <= 15.0 + 1.0))));
    flow:
        d/dt[gClk] = 1.0;
        d/dt[y] = -0.15 * (x * x * y + x + y);
        d/dt[x] = 0.1 * y;
    jump:
            (true) ==> @3(and (gClk' = gClk) (x' = x) (y' = y));
}
init:
@2 (and (and (x <= 1.2) (1.0 <= x)) (and (1.0 <= y) (and (gClk = 0.0) (y <= 1.2))));
goal:
@3 true;
